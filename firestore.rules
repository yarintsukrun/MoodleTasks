rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Per-user settings (filters, task overrides, connection flags).
    // Readable/writable only by the owner. fcmTokens and pushEnabled are
    // server-managed only (push is enabled/disabled per device via functions).
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(['fcmTokens', 'pushEnabled']);
      allow update: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['fcmTokens', 'pushEnabled']);
    }

    // Encrypted secrets (Moodle token, Gemini key). NO client access at all —
    // only the Cloud Functions Admin SDK can read or write these.
    match /secrets/{userId} {
      allow read, write: if false;
    }

    // Rate-limit counters, managed only by Cloud Functions.
    match /rateLimits/{userId} {
      allow read, write: if false;
    }

    // Cached Moodle .ics per user (server-only, 15 min TTL).
    match /calendarCache/{userId} {
      allow read, write: if false;
    }

    // Push notification state (known task ids) — server-only.
    match /notificationState/{userId} {
      allow read, write: if false;
    }
  }
}
